    "@sentry/bun": "^11.14.0",
    "ai": "^7.0.173",
    "better-auth": "^1.7.15",
    "express": "^5.3.0",
    "pg-boss": "^12.38.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
