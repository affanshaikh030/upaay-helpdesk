DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:5173"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="at-least-12-characters"
SEED_ADMIN_NAME="Admin"
# Only needed to promote an existing non-admin user with SEED_ADMIN_EMAIL
# SEED_PROMOTE_EXISTING="true"
# Shared secret for POST /api/inbound/email (sent as the x-inbound-secret header). Unset disables the endpoint
INBOUND_EMAIL_SECRET="generate-with-openssl-rand-base64-32"
NODE_ENV="development"
# Set to "true" behind a reverse proxy (e.g. Railway) so rate limiting sees real client IPs
TRUST_PROXY_HEADERS="false"
