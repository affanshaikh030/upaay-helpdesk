# Copy to e2e/.env.test (gitignored) and fill in. Used only by Playwright.
# The database name MUST end in _test: the setup script refuses to reset anything else.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk_test"
BETTER_AUTH_SECRET="generate-a-different-secret-with-openssl-rand-base64-32"

# Ports differ from dev (3000/5173) so tests can run alongside the dev servers
E2E_SERVER_PORT="3100"
E2E_CLIENT_PORT="5183"

# Users created in the test database on every run
E2E_ADMIN_EMAIL="admin@test.local"
E2E_ADMIN_PASSWORD="admin-test-password-1"
E2E_AGENT_EMAIL="agent@test.local"
E2E_AGENT_PASSWORD="agent-test-password-1"

# Shared secret for POST /api/inbound/email (random, 32+ characters)
INBOUND_EMAIL_SECRET="generate-with-openssl-rand-base64-32"
